<Window x:Class="RAMSOfficial.ManualIdInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manual ID Entry"
        Height="380" 
        Width="540"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Shimmer animation brush for the input border -->
        <Storyboard x:Key="ShimmerAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ShimmerTranslate"
                             Storyboard.TargetProperty="X"
                             From="-500" To="500" Duration="0:0:2.4">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Input focus glow pulse -->
        <Storyboard x:Key="FocusPulse" RepeatBehavior="Forever">
            <ColorAnimation Storyboard.TargetName="InputBorderBrush"
                            Storyboard.TargetProperty="Color"
                            From="#2196F3" To="#64B5F6" Duration="0:0:1.2"
                            AutoReverse="True">
                <ColorAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </ColorAnimation.EasingFunction>
            </ColorAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource ShimmerAnimation}"/>
            <BeginStoryboard Storyboard="{StaticResource FocusPulse}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border CornerRadius="20" BorderThickness="0">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFFFFF" Offset="0"/>
                <GradientStop Color="#F8FAFF" Offset="0.5"/>
                <GradientStop Color="#F0F4FF" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#1565C0" Direction="270"
                              ShadowDepth="12" Opacity="0.18" BlurRadius="36"/>
        </Border.Effect>

        <Grid>
            <!-- Decorative top accent bar -->
            <Border Height="5" VerticalAlignment="Top"
                    CornerRadius="20,20,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1565C0" Offset="0"/>
                        <GradientStop Color="#1E88E5" Offset="0.4"/>
                        <GradientStop Color="#FFD600" Offset="0.8"/>
                        <GradientStop Color="#FF9800" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Shimmer overlay (subtle) -->
            <Border CornerRadius="20" ClipToBounds="True" Opacity="0.04"
                    IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <LinearGradientBrush.RelativeTransform>
                            <TranslateTransform x:Name="ShimmerTranslate" X="-500"/>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="Transparent" Offset="0.0"/>
                        <GradientStop Color="White" Offset="0.45"/>
                        <GradientStop Color="White" Offset="0.55"/>
                        <GradientStop Color="Transparent" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="36,28,36,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,8,0,22">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1565C0" Offset="0"/>
                                    <GradientStop Color="#1E88E5" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#x2328;" FontSize="18" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="MANUAL ID ENTRY" FontSize="24" FontWeight="ExtraBold"
                                   VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#0D47A1" Offset="0"/>
                                    <GradientStop Color="#1E88E5" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="Enter your Employee ID or RFID Code"
                               FontSize="13" Foreground="#90A4AE"
                               TextAlignment="Center"/>
                </StackPanel>

                <!-- Input Field with glow border -->
                <Border Grid.Row="1" CornerRadius="14" Padding="2"
                        Margin="0,0,0,18">
                    <Border.BorderBrush>
                        <SolidColorBrush x:Name="InputBorderBrush" Color="#2196F3"/>
                    </Border.BorderBrush>
                    <Border.BorderThickness>
                        <Thickness>2</Thickness>
                    </Border.BorderThickness>
                    <Border Background="#F5F7FA" CornerRadius="12" Padding="14,12">
                        <TextBox x:Name="IdInputTextBox"
                                 FontSize="26" FontWeight="Bold"
                                 TextAlignment="Center"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="#0D47A1"
                                 CaretBrush="#1E88E5"
                                 MaxLength="10"
                                 GotFocus="IdInputTextBox_GotFocus"
                                 PreviewTextInput="IdInputTextBox_PreviewTextInput"
                                 TextChanged="IdInputTextBox_TextChanged"/>
                    </Border>
                </Border>

                <!-- Instructions -->
                <Border Grid.Row="2" CornerRadius="12" Padding="14,10"
                        Margin="0,0,0,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#E3F2FD" Offset="0"/>
                            <GradientStop Color="#EDE7F6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Background="#43A047" CornerRadius="5"
                                    Padding="8,3" Margin="0,0,8,0">
                                <TextBlock Text="ENTER" FontSize="11" FontWeight="Black"
                                           Foreground="White"/>
                            </Border>
                            <TextBlock Text="Submit" FontSize="13" Foreground="#1B5E20"
                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="1" Background="#CFD8DC" Margin="12,2"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Background="#E53935" CornerRadius="5"
                                    Padding="8,3" Margin="0,0,8,0">
                                <TextBlock Text="ESC" FontSize="11" FontWeight="Black"
                                           Foreground="White"/>
                            </Border>
                            <TextBlock Text="Cancel" FontSize="13" Foreground="#B71C1C"
                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Character Count -->
                <TextBlock Grid.Row="3" x:Name="CharCountTextBlock"
                           Text="0 / 10" FontSize="11.5"
                           Foreground="#B0BEC5" TextAlignment="Center"
                           Margin="0,0,0,6"/>

                <!-- Footer mode indicator -->
                <Border Grid.Row="4" CornerRadius="10" Padding="10,8"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Background>
                        <SolidColorBrush Color="#FFF8E1" Opacity="0.7"/>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2328;" FontSize="14" Foreground="#F57C00"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Keyboard Entry Mode" FontSize="13"
                                   FontWeight="SemiBold" Foreground="#EF6C00"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
