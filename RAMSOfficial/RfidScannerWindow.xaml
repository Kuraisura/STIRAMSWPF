<Window x:Class="RAMSOfficial.RfidScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RFID Scanner - Waiting for Reader"
        Height="1080"
        Width="1920"
        WindowStyle="None"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        Background="#F4FAF6"
        ResizeMode="NoResize"
        Topmost="False"
        ShowInTaskbar="True"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated"
        SourceInitialized="Window_SourceInitialized">

    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CFE8D7"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="40"/>
        </Style>

        <Storyboard x:Key="SpinAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SearchIcon"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:2"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource SpinAnimation}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Border Style="{StaticResource CardStyle}"
                MaxWidth="900"
                MaxHeight="760"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <Viewbox Width="200" Height="200" Margin="0,0,0,30">
                    <Canvas Width="100" Height="100" x:Name="SearchIcon" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Canvas.RenderTransform>

                        <Ellipse Width="50" Height="50" Canvas.Left="10" Canvas.Top="10" Stroke="#16A34A" StrokeThickness="6" Fill="Transparent"/>
                        <Rectangle Width="8" Height="40" Canvas.Left="50" Canvas.Top="55" Fill="#16A34A">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45" CenterX="4" CenterY="0"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Canvas>
                </Viewbox>

                <TextBlock Text="WAITING FOR RFID CARD READER"
                           FontSize="44"
                           FontWeight="Black"
                           Foreground="#14532D"
                           TextAlignment="Center"
                           Margin="0,0,0,15"/>

                <TextBlock Text="Please connect the RFID Card Reader to continue"
                           FontSize="22"
                           Foreground="#334155"
                           TextAlignment="Center"
                           Margin="0,0,0,20"/>

                <Border Background="#FFFBEB"
                        BorderBrush="#FDE68A"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="25"
                        Margin="0,0,0,30">
                    <StackPanel>
                        <TextBlock FontSize="16" Foreground="#92400E" TextAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,12">
                            <Run Text="&#x1F50E;" FontSize="20"/>
                            <Run Text=" Looking for a USB RFID Card Reader"/>
                        </TextBlock>
                        <Border Background="White" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="15">
                            <TextBlock Text="Connect any USB HID RFID reader to this device"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#92400E"
                                       TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

                <ProgressBar IsIndeterminate="True"
                             Width="450"
                             Height="8"
                             Foreground="#16A34A"
                             Background="#DCFCE7"
                             BorderThickness="0"
                             Margin="0,0,0,35"/>

                <TextBlock Text="The system will automatically detect the reader..."
                           FontSize="16"
                           Foreground="#64748B"
                           TextAlignment="Center"
                           FontStyle="Italic"
                           Margin="0,10,0,0"/>

                <Border Background="#F0FDF4"
                        BorderBrush="#BBF7D0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,30,0,0">
                    <StackPanel>
                        <TextBlock FontSize="14" Foreground="#166534" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,10">
                            <Run Text="&#x1F4A1;"/> Troubleshooting:
                        </TextBlock>
                        <TextBlock FontSize="13" Foreground="#475569" TextAlignment="Left" TextWrapping="Wrap" Margin="20,0,20,0">
                            <Run Text="&#x2022;"/> Ensure the RFID reader is plugged into a USB port<LineBreak/>
                            <Run Text="&#x2022;"/> Try unplugging and plugging it back in<LineBreak/>
                            <Run Text="&#x2022;"/> Check if the device appears in Device Manager<LineBreak/>
                            <Run Text="&#x2022;"/> The app connects automatically when reader is detected
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>