<Window x:Class="RAMSOfficial.CompleteAttendanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attendance Complete"
        WindowStyle="None"
        WindowState="Maximized"
        Height="1080"
        Width="1920"
        WindowStartupLocation="CenterScreen"
        Background="#F4FAF6"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="PageBg" Color="#F4FAF6"/>
        <SolidColorBrush x:Key="MainGreen" Color="#16A34A"/>
        <SolidColorBrush x:Key="MainGreenDark" Color="#14532D"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#CFE8D7"/>
        <SolidColorBrush x:Key="MutedBg" Color="#F8FBF9"/>
        <SolidColorBrush x:Key="MutedBorder" Color="#DCE9E2"/>
        <SolidColorBrush x:Key="TextBody" Color="#334155"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="InfoBlue" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="InfoBlueBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="InfoBlueBorder" Color="#BFDBFE"/>
        <SolidColorBrush x:Key="SuccessBg" Color="#F0FDF4"/>
        <SolidColorBrush x:Key="SuccessBorder" Color="#BBF7D0"/>
        <SolidColorBrush x:Key="WarningBg" Color="#FFFBEB"/>
        <SolidColorBrush x:Key="WarningBorder" Color="#FDE68A"/>
        <SolidColorBrush x:Key="WarningText" Color="#92400E"/>

        <Style x:Key="IconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="28"/>
        </Style>

        <Style x:Key="EmployeeDetailRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MutedBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MutedBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Storyboard x:Key="EntranceAnim">
            <DoubleAnimation Storyboard.TargetName="RootContainer"
                             Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             Duration="0:0:0.25"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource EntranceAnim}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="{StaticResource PageBg}">
        <Grid x:Name="RootContainer" Opacity="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource MainGreen}" Padding="36,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource IconStyle}" Foreground="White" FontSize="28" Margin="0,0,12,0"/>
                        <TextBlock Text="ATTENDANCE COMPLETE FOR TODAY"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="30"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#FFFFFF"
                            BorderBrush="#D9F99D"
                            BorderThickness="2"
                            CornerRadius="18"
                            Padding="16,8"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE823;" Style="{StaticResource IconStyle}" Foreground="#65A30D" Margin="0,0,8,0"/>
                            <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#3F6212" VerticalAlignment="Center">
                                <Run Text="Closing in "/>
                                <Run x:Name="CountdownRun" FontWeight="Black" FontSize="24"/>
                                <Run Text=" s"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="28,20,28,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="410"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Border Width="170" Height="170" CornerRadius="85"
                                HorizontalAlignment="Center"
                                BorderBrush="{StaticResource MainGreen}"
                                BorderThickness="4"
                                Background="{StaticResource SuccessBg}"
                                Margin="0,0,0,20"
                                ClipToBounds="True">
                            <Grid>
                                <Image x:Name="PhotoImage"
                                       Stretch="UniformToFill"
                                       Visibility="Collapsed"/>
                                <Viewbox x:Name="InitialViewbox" Margin="34">
                                    <TextBlock x:Name="InitialTextBlock"
                                               FontSize="80"
                                               FontWeight="Black"
                                               Foreground="{StaticResource MainGreen}"/>
                                </Viewbox>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="NameTextBlock"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MainGreenDark}"
                                   Margin="0,0,0,4"/>

                        <TextBlock TextAlignment="Center" FontSize="16" Foreground="{StaticResource TextMuted}" Margin="0,0,0,20">
                            <Run x:Name="SchoolIdRun"/>
                            <Run Text="  •  "/>
                            <Run x:Name="EmployeeTypeRun"/>
                        </TextBlock>

                        <Border Style="{StaticResource EmployeeDetailRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE821;" Style="{StaticResource IconStyle}" Foreground="{StaticResource MainGreen}" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="DEPARTMENT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="DepartmentTextBlock" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBody}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource EmployeeDetailRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE716;" Style="{StaticResource IconStyle}" Foreground="{StaticResource MainGreen}" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="STAFF TYPE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="RoleRun" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBody}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource EmployeeDetailRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE81B;" Style="{StaticResource IconStyle}" Foreground="{StaticResource MainGreen}" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="EmploymentStatusRun" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBody}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource IconStyle}" Foreground="{StaticResource MainGreen}" Margin="0,0,10,0"/>
                            <TextBlock Text="TODAY'S COMPLETE ATTENDANCE"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MainGreenDark}"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{StaticResource MutedBg}"
                                    BorderBrush="{StaticResource MutedBorder}"
                                    BorderThickness="1.5"
                                    CornerRadius="12"
                                    Padding="16,13">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE787;" Style="{StaticResource IconStyle}" Foreground="{StaticResource TextMuted}" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="DateTextBlock" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBody}"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="ExpectedScheduleBorder"
                                    Grid.Column="2"
                                    Background="{StaticResource SuccessBg}"
                                    BorderBrush="{StaticResource SuccessBorder}"
                                    BorderThickness="1.5"
                                    CornerRadius="12"
                                    Padding="16,13">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE121;" Style="{StaticResource IconStyle}" Foreground="{StaticResource MainGreen}" Margin="0,0,10,0"/>
                                    <TextBlock Text="EXPECTED:" FontSize="15" FontWeight="Black" Foreground="{StaticResource MainGreen}" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="ExpectedScheduleTextBlock" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBody}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="TimeInRecordBorder"
                                    Grid.Column="0"
                                    Background="{StaticResource SuccessBg}"
                                    BorderBrush="{StaticResource SuccessBorder}"
                                    BorderThickness="2"
                                    CornerRadius="16"
                                    Padding="24">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="10" Padding="10,6" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE898;" Style="{StaticResource IconStyle}" Foreground="{StaticResource MainGreen}" FontSize="18"/>
                                            <TextBlock Text="TIME IN" FontSize="18" FontWeight="Black" Foreground="{StaticResource MainGreen}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="TimeInTextBlock"
                                               Grid.Row="1"
                                               FontSize="64"
                                               FontWeight="Black"
                                               Foreground="{StaticResource MainGreenDark}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <Border x:Name="TimeInStatusBorder"
                                            Grid.Row="2"
                                            CornerRadius="12"
                                            BorderThickness="1.5"
                                            Padding="14,8"
                                            HorizontalAlignment="Center">
                                        <TextBlock x:Name="TimeInStatusTextBlock" FontSize="18" FontWeight="Bold" TextAlignment="Center"/>
                                    </Border>

                                     <TextBlock x:Name="TimeInSourceTextBlock"
                                                Grid.Row="3"
                                                Margin="0,10,0,0"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource TextMuted}"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap"
                                                Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <Border x:Name="TimeOutRecordBorder"
                                    Grid.Column="2"
                                    Background="{StaticResource InfoBlueBg}"
                                    BorderBrush="{StaticResource InfoBlueBorder}"
                                    BorderThickness="2"
                                    CornerRadius="16"
                                    Padding="24">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#DBEAFE" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="10" Padding="10,6" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE89A;" Style="{StaticResource IconStyle}" Foreground="{StaticResource InfoBlue}" FontSize="18"/>
                                            <TextBlock Text="TIME OUT" FontSize="18" FontWeight="Black" Foreground="{StaticResource InfoBlue}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="TimeOutTextBlock"
                                               Grid.Row="1"
                                               FontSize="64"
                                               FontWeight="Black"
                                               Foreground="{StaticResource MainGreenDark}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <Border x:Name="TimeOutStatusBorder"
                                            Grid.Row="2"
                                            CornerRadius="12"
                                            BorderThickness="1.5"
                                            Padding="14,8"
                                            HorizontalAlignment="Center">
                                        <TextBlock x:Name="TimeOutStatusTextBlock" FontSize="18" FontWeight="Bold" TextAlignment="Center"/>
                                    </Border>

                                     <TextBlock x:Name="TimeOutSourceTextBlock"
                                                Grid.Row="3"
                                                Margin="0,10,0,0"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource TextMuted}"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap"
                                                Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Row="3"
                                Background="{StaticResource WarningBg}"
                                BorderBrush="{StaticResource WarningBorder}"
                                BorderThickness="1.5"
                                CornerRadius="12"
                                Padding="16,14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource IconStyle}" FontSize="22" Foreground="{StaticResource WarningText}" Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Text="ATTENDANCE COMPLETED FOR TODAY" FontSize="20" FontWeight="Black" Foreground="{StaticResource WarningText}"/>
                                    <TextBlock x:Name="TapCountTextBlock" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBody}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="#DDEEE4" Padding="0,10">
                <TextBlock Text="This window closes automatically. Press ESC to dismiss now."
                           FontSize="13"
                           Foreground="{StaticResource TextMuted}"
                           TextAlignment="Center"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>
    </Border>
</Window>