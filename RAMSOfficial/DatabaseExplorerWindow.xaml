<Window x:Class="RAMSOfficial.DatabaseExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Database Explorer"
        Height="680"
        Width="1080"
        MinWidth="860"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E2E8F0" CornerRadius="10" Padding="10" Margin="0,0,0,10">
            <TextBlock x:Name="HeaderText" FontWeight="Bold" Foreground="#0F172A" FontSize="15" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Background="White">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Tables" FontWeight="Bold" Padding="10" Foreground="#334155"/>
                    <ListBox x:Name="TablesListBox" SelectionChanged="TablesListBox_SelectionChanged"/>
                </DockPanel>
            </Border>

            <TabControl Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1">
                <TabItem Header="Schema">
                    <DataGrid x:Name="SchemaGrid"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"/>
                </TabItem>
                <TabItem Header="Data (Top 200)">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="8">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="Select All" Margin="0,0,8,0" Padding="12,6" Click="SelectAllRows_Click"/>
                                    <Button Content="Clear Selection" Margin="0,0,8,0" Padding="12,6" Click="ClearSelectedRows_Click"/>
                                    <Button Content="Save Selected Row" Margin="0,0,8,0" Padding="12,6" Click="SaveSelectedRow_Click"/>
                                    <Button Content="Delete Checked Rows" Margin="0,0,8,0" Padding="12,6" Click="DeleteSelectedRow_Click"/>
                                    <Button Content="Delete All Rows" Padding="12,6" Click="DeleteAllRows_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="DataHintText"
                                           VerticalAlignment="Center"
                                           Foreground="#334155"
                                           Text="Tick rows in Select column, edit cells, then save or delete."/>
                            </DockPanel>
                        </Border>

                        <DataGrid x:Name="DataGridView"
                                  Grid.Row="1"
                                  AutoGenerateColumns="True"
                                  AutoGeneratingColumn="DataGridView_AutoGeneratingColumn"
                                  IsReadOnly="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"/>
                    </Grid>
                </TabItem>
                <TabItem Header="Backups">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="8">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="Refresh" Margin="0,0,8,0" Padding="12,6" Click="RefreshBackups_Click"/>
                                    <Button Content="Open Selected Backup" Margin="0,0,8,0" Padding="12,6" Click="OpenSelectedBackup_Click"/>
                                    <Button Content="Open Backup Folder" Padding="12,6" Click="OpenBackupFolder_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="BackupsHintText"
                                           VerticalAlignment="Center"
                                           Foreground="#334155"
                                           Text="Browse backup files and open any backup in the internal database explorer."/>
                            </DockPanel>
                        </Border>

                        <DataGrid x:Name="BackupsGrid"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*"/>
                                <DataGridTextColumn Header="Modified" Binding="{Binding LastModified}" Width="*"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="*"/>
                                <DataGridTextColumn Header="Path" Binding="{Binding FullPath}" Width="3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="SQL Query">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="140"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="8">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="Execute" Margin="0,0,8,0" Padding="14,6" Click="ExecuteSql_Click"/>
                                    <Button Content="Clear" Padding="14,6" Click="ClearSql_Click"/>
                                </StackPanel>
                                <TextBlock Text="Write SQL query/script and execute against the current database file."
                                           VerticalAlignment="Center"
                                           Foreground="#334155"/>
                            </DockPanel>
                        </Border>

                        <TextBox x:Name="SqlQueryTextBox"
                                 Grid.Row="1"
                                 Margin="8"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 FontFamily="Consolas"
                                 FontSize="13"/>

                        <TextBlock x:Name="SqlStatusText"
                                   Grid.Row="2"
                                   Margin="8,0,8,6"
                                   Foreground="#334155"
                                   Text="Ready."/>

                        <DataGrid x:Name="SqlResultsGrid"
                                  Grid.Row="3"
                                  Margin="8,0,8,8"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
