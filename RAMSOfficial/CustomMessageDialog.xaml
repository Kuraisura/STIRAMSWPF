<Window x:Class="RAMSOfficial.CustomMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message"
        SizeToContent="Height"
        MaxHeight="760"
        Width="860"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="#EEF4FF"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.18"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.96" To="1" Duration="0:0:0.18"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.96" To="1" Duration="0:0:0.18"/>
        </Storyboard>

        <Storyboard x:Key="FadeOutAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.12"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="1" To="0.98" Duration="0:0:0.12"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="1" To="0.98" Duration="0:0:0.12"/>
        </Storyboard>
    </Window.Resources>

    <Border Background="White"
            CornerRadius="18"
            BorderBrush="#D9E4F7"
            BorderThickness="1.5"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with icon -->
            <Border Grid.Row="0"
                    x:Name="HeaderBorder"
                    Background="#0B5CAD"
                    CornerRadius="18,18,0,0"
                    Padding="28,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Width="48" Height="48" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Canvas Width="100" Height="100">
                            <Ellipse x:Name="IconCircle" Width="100" Height="100" Fill="#FFFFFF" Opacity="0.18"/>
                            <Path x:Name="IconPath"
                                  Data="M50,20 L50,60 M50,70 L50,75"
                                  Stroke="White"
                                  StrokeThickness="8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleTextBlock"
                                   Text="WARNING"
                                   FontSize="28"
                                   FontWeight="Black"
                                   Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer x:Name="ContentScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,18">
                    <TextBlock x:Name="MessageTextBlock"
                               Text="Message content goes here"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <Border x:Name="DetailsBorder"
                            Background="#F8FAFC"
                            BorderBrush="#D9E4F7"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,0,0,12"
                            Visibility="Collapsed">
                        <TextBlock x:Name="DetailsTextBlock"
                                   FontSize="16"
                                   Foreground="#334155"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineHeight="24"/>
                    </Border>

                    <Border Background="#FFF8E1"
                            BorderBrush="#FDE68A"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Padding="12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#B45309"/>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#92400E" VerticalAlignment="Center">
                                <Run Text="Auto-closing in "/>
                                <Run x:Name="CountdownRun" Text="3" FontSize="24" FontWeight="Black" Foreground="#B45309"/>
                                <Run Text=" seconds..."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="#F8FAFC"
                    BorderBrush="#D9E4F7"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,18,18"
                    Padding="18,12">
                <Button x:Name="OkButton"
                        Content="OK, I UNDERSTAND"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="#0B5CAD"
                        BorderThickness="0"
                        Padding="22,10"
                        Cursor="Hand"
                        Click="OkButton_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>
