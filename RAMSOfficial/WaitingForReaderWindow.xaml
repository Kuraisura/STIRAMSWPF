<Window x:Class="RAMSOfficial.WaitingForReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Waiting for RFID Reader"
        Height="1080" Width="1920"
        WindowStyle="None"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="False"
        ShowInTaskbar="True"
        AllowsTransparency="False"
        UseLayoutRounding="True"
        SourceInitialized="Window_SourceInitialized"
        Background="#EAF2FF">

    <Window.Resources>
        <SolidColorBrush x:Key="PageBg" Color="#EAF2FF"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#0B5CAD"/>
        <SolidColorBrush x:Key="HeaderAccent" Color="#FDE047"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#C9D9F4"/>
        <SolidColorBrush x:Key="TitleFg" Color="#0B3D91"/>
        <SolidColorBrush x:Key="BodyFg" Color="#334155"/>
        <SolidColorBrush x:Key="MutedFg" Color="#64748B"/>
    </Window.Resources>

    <Grid Background="{StaticResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="88"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBg}" BorderBrush="#0A3D91" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        VerticalAlignment="Center"
                        Background="#0F4E96"
                        CornerRadius="10"
                        BorderBrush="{StaticResource HeaderAccent}"
                        BorderThickness="1.5"
                        Padding="12,6">
                    <TextBlock Text="STI"
                               Foreground="#FFD600"
                               FontSize="22"
                               FontWeight="ExtraBold"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="STI COLLEGE SANTA ROSA" Foreground="White" FontSize="30" FontWeight="Black"/>
                    <TextBlock Text="Attendance Management System" Foreground="#DBEAFE" FontSize="12"/>
                </StackPanel>

                <Border Grid.Column="2"
                        VerticalAlignment="Center"
                        Background="#0A3D91"
                        BorderBrush="{StaticResource HeaderAccent}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,6">
                    <TextBlock Text="Reader Setup"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="13"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="860"
                    Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1.5"
                    CornerRadius="20"
                    Padding="36">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Width="120"
                            Height="120"
                            CornerRadius="60"
                            HorizontalAlignment="Center"
                            Background="#E8F1FB"
                            BorderBrush="#93C5FD"
                            BorderThickness="2">
                        <Grid>
                            <Border Width="78" Height="78" CornerRadius="39" Background="#0B5CAD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE7F5;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="36"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1"
                               Text="WAITING FOR RFID READER"
                               Margin="0,20,0,6"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TitleFg}"
                               FontSize="38"
                               FontWeight="Black"/>

                    <TextBlock Grid.Row="2"
                               Text="Connect the RFID card reader to continue"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource BodyFg}"
                               FontSize="18"
                               Margin="0,0,0,22"/>

                    <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,0,0,22">
                        <ProgressBar Width="520"
                                     Height="8"
                                     IsIndeterminate="True"
                                     Foreground="#1D4ED8"
                                     Background="#DBEAFE"
                                     BorderThickness="0"/>
                        <TextBlock Text="Scanning USB devices..."
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource MutedFg}"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <Border Grid.Row="4"
                            Background="#F8FAFC"
                            BorderBrush="#D9E4F7"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="Troubleshooting"
                                       Foreground="#0B3D91"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10"/>
                            <TextBlock Foreground="{StaticResource BodyFg}" FontSize="14" LineHeight="24">
                                <Run Text="• Ensure the RFID reader is plugged into a USB port"/><LineBreak/>
                                <Run Text="• Try a different USB port if the reader is not detected"/><LineBreak/>
                                <Run Text="• The system will connect automatically once detected"/><LineBreak/>
                                <Run Text="• Press P to bypass reader check (developer shortcut)"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#DCE7F8" BorderBrush="#C7D7F2" BorderThickness="0,1,0,0">
            <TextBlock Text="RFID Attendance Kiosk  •  Waiting for Reader"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#334155"
                       FontSize="12"
                       FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
