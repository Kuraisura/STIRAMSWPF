<Window x:Class="RAMSOfficial.TimeChangerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Time Override - Testing Tool"
        Height="640"
        Width="980"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="#EEF5F0"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.97" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.97" To="1" Duration="0:0:0.2"/>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="MainBorder"
            Background="White"
            CornerRadius="18"
            BorderBrush="#D6E4DB"
            BorderThickness="1.5"
            RenderTransformOrigin="0.5,0.5"
            Opacity="0">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#15803D" CornerRadius="18,18,0,0" Padding="28,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="68" Height="68" CornerRadius="34" Background="#14532D" BorderBrush="#86EFAC" BorderThickness="2" VerticalAlignment="Center">
                        <Viewbox Margin="14">
                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="White"/>
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TIME CHANGER" FontSize="30" FontWeight="Black" Foreground="White"/>
                        <TextBlock Text="Testing tool - use only for controlled scenarios" FontSize="13" Foreground="#DCFCE7" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30,22">
                <StackPanel>

                    <!-- Access Control -->
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,10">
                                <Run Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"/>
                                <Run Text=" ACCESS CONTROL"/>
                            </TextBlock>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <PasswordBox x:Name="AccessPasswordBox"
                                             Grid.Column="0"
                                             FontSize="16"
                                             Padding="12,8"
                                             Margin="0,0,10,0"
                                             KeyDown="AccessPasswordBox_KeyDown"/>

                                <Button x:Name="UnlockAccessButton"
                                        Grid.Column="1"
                                        Content="UNLOCK"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Background="#15803D"
                                        BorderThickness="0"
                                        Padding="14,8"
                                        Cursor="Hand"
                                        Click="UnlockAccessButton_Click"/>
                            </Grid>

                            <TextBlock x:Name="AccessErrorText"
                                       Text="Incorrect password."
                                       FontSize="12"
                                       Foreground="#DC2626"
                                       Margin="0,8,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Status -->
                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1.5" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="#166534" Margin="0,0,0,10">
                                <Run Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets"/>
                                <Run Text=" CURRENT STATUS"/>
                            </TextBlock>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mode:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,10,0"/>
                                <TextBlock x:Name="StatusModeText" Grid.Column="1" Text="Real Time" FontWeight="Bold" Foreground="#15803D"/>
                            </Grid>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Current Time:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,10,0"/>
                                <TextBlock x:Name="CurrentTimeText" Grid.Column="1" Text="--:--" FontWeight="Bold" Foreground="#0F172A"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Date/Time selectors -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,10">
                                    <Run Text="&#xE787;" FontFamily="Segoe MDL2 Assets"/>
                                    <Run Text=" SELECT DATE"/>
                                </TextBlock>

                                <DatePicker x:Name="CustomDatePicker" FontSize="16" SelectedDateChanged="CustomDatePicker_SelectedDateChanged"/>
                                <TextBlock x:Name="DayOfWeekText" Text="Day: Monday" FontSize="13" Foreground="#64748B" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,10">
                                    <Run Text="&#xE823;" FontFamily="Segoe MDL2 Assets"/>
                                    <Run Text=" SELECT TIME"/>
                                </TextBlock>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Hour (00-23)" FontSize="12" Foreground="#64748B" TextAlignment="Center" Margin="0,0,0,5"/>
                                        <TextBox x:Name="HourTextBox"
                                                 Text="08"
                                                 FontSize="30"
                                                 FontWeight="Black"
                                                 TextAlignment="Center"
                                                 MaxLength="2"
                                                 PreviewTextInput="NumericTextBox_PreviewTextInput"
                                                 TextChanged="TimeTextBox_TextChanged"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text=":" FontSize="34" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" Margin="14,24,14,0"/>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Minute (00-59)" FontSize="12" Foreground="#64748B" TextAlignment="Center" Margin="0,0,0,5"/>
                                        <TextBox x:Name="MinuteTextBox"
                                                 Text="00"
                                                 FontSize="30"
                                                 FontWeight="Black"
                                                 TextAlignment="Center"
                                                 MaxLength="2"
                                                 PreviewTextInput="NumericTextBox_PreviewTextInput"
                                                 TextChanged="TimeTextBox_TextChanged"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Preview -->
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.5" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,0,0,8">
                                <Run Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets"/>
                                <Run Text=" PREVIEW"/>
                            </TextBlock>
                            <TextBlock x:Name="PreviewText" Text="Monday, January 15, 2024 08:00 AM" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Warning note -->
                    <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1.5" CornerRadius="12" Padding="14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#DC2626" Margin="0,0,10,0" VerticalAlignment="Top"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#7F1D1D">
                                <Run Text="Warning: "/><Run Text="Setting override time affects all timestamp operations. A confirmation warning dialog appears when you click Set Time Override."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#D6E4DB" BorderThickness="0,1,0,0" CornerRadius="0,0,18,18" Padding="22,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" FontStyle="Italic">
                        <Run Text="&#xE946;" FontFamily="Segoe MDL2 Assets"/>
                        <Run Text=" Press ESC to cancel"/>
                    </TextBlock>

                    <Button x:Name="ClearButton"
                            Grid.Column="1"
                            Content="CLEAR OVERRIDE"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="White"
                            Background="#64748B"
                            BorderThickness="0"
                            Padding="18,10"
                            Margin="0,0,10,0"
                            Cursor="Hand"
                            Click="ClearButton_Click"/>

                    <Button x:Name="CancelButton"
                            Grid.Column="2"
                            Content="CANCEL"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#334155"
                            Background="#E2E8F0"
                            BorderThickness="0"
                            Padding="18,10"
                            Margin="0,0,10,0"
                            Cursor="Hand"
                            Click="CancelButton_Click"/>

                    <Button x:Name="SetButton"
                            Grid.Column="3"
                            Content="SET TIME OVERRIDE"
                            FontSize="14"
                            FontWeight="Black"
                            Foreground="White"
                            Background="#F59E0B"
                            BorderThickness="0"
                            Padding="22,10"
                            Cursor="Hand"
                            Click="SetButton_Click"/>
                </Grid>
            </Border>

            <!-- Custom confirmation dialog overlay -->
            <Grid x:Name="ConfirmOverlay"
                  Grid.RowSpan="3"
                  Background="#80000000"
                  Visibility="Collapsed"
                  Panel.ZIndex="2000">
                <Border Background="White"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        MaxWidth="560"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#0B5CAD" CornerRadius="14,14,0,0" Padding="18,12">
                            <TextBlock x:Name="ConfirmTitleText"
                                       Text="Confirm Action"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>

                        <Border Grid.Row="1" Padding="22,18">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#1D4ED8" Margin="0,0,10,0"/>
                                    <TextBlock Text="Please review before continuing"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock x:Name="ConfirmMessageText"
                                           FontSize="14"
                                           Foreground="#1F2937"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,14,14" Padding="14,12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ConfirmNoButton"
                                        Content="Cancel"
                                        Width="110"
                                        Padding="10,8"
                                        Margin="0,0,10,0"
                                        Background="#E2E8F0"
                                        Foreground="#334155"
                                        BorderThickness="0"
                                        Click="ConfirmNoButton_Click"/>
                                <Button x:Name="ConfirmYesButton"
                                        Content="Confirm"
                                        Width="140"
                                        Padding="10,8"
                                        Background="#F59E0B"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Click="ConfirmYesButton_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Custom notice dialog overlay (single-button) -->
            <Grid x:Name="NoticeOverlay"
                  Grid.RowSpan="3"
                  Background="#80000000"
                  Visibility="Collapsed"
                  Panel.ZIndex="2100">
                <Border Background="White"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        MaxWidth="540"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#0B5CAD" CornerRadius="14,14,0,0" Padding="18,12">
                            <TextBlock x:Name="NoticeTitleText"
                                       Text="Notice"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>

                        <Border Grid.Row="1" Padding="22,18">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#1D4ED8" Margin="0,0,10,0"/>
                                    <TextBlock Text="Please check the message below"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock x:Name="NoticeMessageText"
                                           FontSize="14"
                                           Foreground="#1F2937"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,14,14" Padding="14,12">
                            <Button x:Name="NoticeOkButton"
                                    Content="OK"
                                    Width="120"
                                    Padding="10,8"
                                    Background="#0B5CAD"
                                    Foreground="White"
                                    BorderThickness="0"
                                    HorizontalAlignment="Right"
                                    Click="NoticeOkButton_Click"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>