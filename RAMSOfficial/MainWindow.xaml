<Window x:Class="RAMSOfficial.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RAMSOfficial.Converters"
        Title="RAMS - STI Santa Rosa Attendance System"
        Height="1080" 
        Width="1920"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="False"
        ShowInTaskbar="True"
        Loaded="Window_Loaded"
        Activated="Window_activated"
        GotFocus="Window_GotFocus"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        SourceInitialized="MainWindow_SourceInitialized"
        Closing="Window_Closing">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <SolidColorBrush x:Key="PageBg" Color="#EEF4FF"/>
        <SolidColorBrush x:Key="SurfaceBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceBorder" Color="#D9E4F7"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#0B5CAD"/>
        <SolidColorBrush x:Key="HeaderDeep" Color="#0A3D91"/>
        <SolidColorBrush x:Key="HeaderAccent" Color="#FDE047"/>
        <SolidColorBrush x:Key="TitleText" Color="#14532D"/>
        <SolidColorBrush x:Key="BodyMuted" Color="#475569"/>

        <!-- ═══ Animations ═══ -->

        <!-- Pulsing outer ring on scan icon -->
        <Storyboard x:Key="PulseRingAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ScanPulseRing"
                             Storyboard.TargetProperty="Opacity"
                             From="0.12" To="0.03" Duration="0:0:1.8"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ScanPulseRing"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="1.0" To="1.10" Duration="0:0:1.8"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ScanPulseRing"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="1.0" To="1.10" Duration="0:0:1.8"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Pulsing middle ring -->
        <Storyboard x:Key="PulseMiddleRingAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ScanMiddleRing"
                             Storyboard.TargetProperty="Opacity"
                             From="0.10" To="0.04" Duration="0:0:2.2"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Gentle glow pulse on READY TO SCAN text -->
        <Storyboard x:Key="ReadyTextPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ReadyToScanText"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.7" Duration="0:0:2.0"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Waiting-for-reader spinner pulse -->
        <Storyboard x:Key="WaitingPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="WaitingIcon"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.35" Duration="0:0:1.0"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Processing dot pulse -->
        <Storyboard x:Key="ProcessingDotPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ProcessingDot"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.3" Duration="0:0:0.6"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource PulseRingAnimation}"/>
            <BeginStoryboard Storyboard="{StaticResource PulseMiddleRingAnimation}"/>
            <BeginStoryboard Storyboard="{StaticResource ReadyTextPulse}"/>
            <BeginStoryboard Storyboard="{StaticResource WaitingPulse}"/>
            <BeginStoryboard Storyboard="{StaticResource ProcessingDotPulse}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid Background="{StaticResource PageBg}" SnapsToDevicePixels="True"
          RenderOptions.BitmapScalingMode="LowQuality"
          TextOptions.TextFormattingMode="Display"
          TextOptions.TextRenderingMode="Auto">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════
             HEADER — Full-bleed gradient bar with glass-style logo
             ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Height="92" Background="{StaticResource HeaderBg}" BorderBrush="#166534" BorderThickness="0,0,0,1">

            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo pill -->
                <Border Grid.Column="0" VerticalAlignment="Center"
                        Background="#0F4E96" CornerRadius="12"
                        BorderBrush="#FDE047" BorderThickness="2"
                        Padding="14,8">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="STI" FontSize="22" FontWeight="ExtraBold"
                                   Foreground="#FFD600" HorizontalAlignment="Center"
                                   FontFamily="Segoe UI"
                                   TextOptions.TextFormattingMode="Display"/>
                        <Border Background="#FFD600" CornerRadius="3"
                                Padding="12,1" Margin="0,-1,0,1">
                            <TextBlock Text="SANTA ROSA" FontSize="6.5" FontWeight="Black"
                                       Foreground="#0A3D91" HorizontalAlignment="Center"
                                       TextOptions.TextFormattingMode="Display"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Centre decorative line accent -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="28,0,0,0">
                    <TextBlock Text="STI COLLEGE SANTA ROSA"
                               FontSize="28" FontWeight="Black" Foreground="White"/>
                    <TextBlock Text="Attendance Management System"
                               FontSize="12" Foreground="#DBEAFE" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Clock capsule -->
                <Border Grid.Column="2" VerticalAlignment="Center"
                        CornerRadius="14" Padding="20,8"
                        BorderBrush="{StaticResource HeaderAccent}" BorderThickness="1.5"
                        Background="{StaticResource HeaderDeep}">
                    <StackPanel>
                        <TextBlock x:Name="ClockTextBlock"
                                   FontSize="28" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center"
                                   TextOptions.TextFormattingMode="Display"/>
                        <TextBlock x:Name="DateTextBlockHeader"
                                   FontSize="11" Foreground="#BFDBFE"
                                   HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════
             CONTENT — Frosted glass aesthetic on light backdrop
             ════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Background="{StaticResource PageBg}">

            <!-- Hidden RFID field -->
            <TextBox x:Name="RfidTextBox"
                     FontSize="1" Padding="0" TextAlignment="Center"
                     GotFocus="RfidTextBox_GotFocus"
                     LostFocus="RfidTextBox_LostFocus"
                     Opacity="0" Height="0"
                     BorderThickness="0" Background="Transparent"
                     IsTabStop="False"/>

            <!-- ═══ PROCESSING OVERLAY — shimmer card while validating ═══ -->
            <Grid Panel.ZIndex="500">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border MaxWidth="500" HorizontalAlignment="Center"
                        VerticalAlignment="Center" CornerRadius="24"
                        Padding="44,36" ClipToBounds="True"
                        BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1.5">
                    <Border.Background>
                        <SolidColorBrush Color="White"/>
                    </Border.Background>
                    

                    <Grid>
                        <!-- Shimmer sweep over the card -->
                        <Border CornerRadius="24" Background="#F8FAFC"
                                IsHitTestVisible="False" Margin="-44,-36">
                        </Border>

                        <StackPanel HorizontalAlignment="Center">
                            <!-- Pulsing dot -->
                            <Grid Width="72" Height="72" Margin="0,0,0,20"
                                  HorizontalAlignment="Center">
                                <Ellipse Width="72" Height="72" Fill="#DBEAFE">
                                </Ellipse>
                                <Ellipse x:Name="ProcessingDot" Width="48" Height="48" Fill="#1D4ED8">
                                </Ellipse>
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="VALIDATING CARD" FontSize="22"
                                       FontWeight="ExtraBold" Foreground="#0A3D91"
                                       HorizontalAlignment="Center"
                                       TextOptions.TextFormattingMode="Display"/>
                            <TextBlock Text="Please wait..." FontSize="13"
                                       Foreground="#455A64" HorizontalAlignment="Center"
                                       Margin="0,4,0,14"/>

                            <!-- Shimmer bar placeholders -->
                            <Border Height="12" CornerRadius="6" Margin="20,0,20,8">
                                <Border.Background>
                                    <SolidColorBrush Color="#E3F2FD"/>
                                </Border.Background>
                            </Border>
                            <Border Height="12" CornerRadius="6" Margin="50,0,50,8">
                                <Border.Background>
                                    <SolidColorBrush Color="#E8EAF6"/>
                                </Border.Background>
                            </Border>
                            <Border Height="12" CornerRadius="6" Margin="30,0,30,0">
                                <Border.Background>
                                    <SolidColorBrush Color="#E3F2FD"/>
                                </Border.Background>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ STATE 1: Waiting for Reader ═══ -->
            <Grid Visibility="{Binding IsWaitingForReader, Converter={StaticResource BoolToVisibility}}">
                <Border MaxWidth="760" HorizontalAlignment="Center"
                        VerticalAlignment="Center" CornerRadius="28"
                        Padding="56,48" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1.5">
                    <Border.Background>
                        <SolidColorBrush Color="White"/>
                    </Border.Background>
                    

                    <StackPanel HorizontalAlignment="Center">
                        <!-- Animated ring + icon -->
                        <Grid Width="130" Height="130" Margin="0,0,0,28"
                              HorizontalAlignment="Center">
                            <Ellipse Stroke="#F44336" StrokeThickness="4"
                                     Opacity="0.18"/>
                            <Ellipse Width="96" Height="96" Fill="#FFEBEE">
                            </Ellipse>
                            <TextBlock x:Name="WaitingIcon" Text="🔍" FontSize="52"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="WAITING FOR RFID READER"
                                   FontSize="34" FontWeight="ExtraBold"
                                   Foreground="#D32F2F" HorizontalAlignment="Center"
                                   TextOptions.TextFormattingMode="Display"/>
                        <TextBlock Text="Connect the RFID Card Reader to continue"
                                   FontSize="16" Foreground="#455A64"
                                   HorizontalAlignment="Center" Margin="0,8,0,28"/>

                        <Border Background="#FFFBEB" CornerRadius="14"
                                Padding="22,14" HorizontalAlignment="Center">
                            <TextBlock FontSize="14" Foreground="#BF360C"
                                       HorizontalAlignment="Center" FontWeight="SemiBold">
                                <Run Text="🔌"/>
                                <Run Text="  Looking for a USB HID RFID reader…"/>
                            </TextBlock>
                        </Border>

                        <ProgressBar IsIndeterminate="True"
                                     Width="360" Height="4"
                                      Foreground="#1D4ED8" Background="#DBEAFE"
                                     BorderThickness="0" Margin="0,24,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ STATE 2: Ready to Scan ═══ -->
            <Grid Visibility="{Binding IsWaitingForTap, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="44,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT — Scan prompt -->
                    <Border Grid.Column="0" CornerRadius="28" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1.5">
                        <Border.Background>
                            <SolidColorBrush Color="White"/>
                        </Border.Background>
                        

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Concentric ring icon -->
                            <Grid Width="180" Height="180" Margin="0,0,0,26"
                                  HorizontalAlignment="Center">
                                <Ellipse x:Name="ScanPulseRing" StrokeThickness="3" Opacity="0.10"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Stroke>
                                    <SolidColorBrush Color="#1D4ED8"/>
                                    </Ellipse.Stroke>
                                </Ellipse>
                                <Ellipse x:Name="ScanMiddleRing" Width="140" Height="140" StrokeThickness="2.5" Opacity="0.08">
                                    <Ellipse.Stroke>
                                        <SolidColorBrush Color="#22C55E"/>
                                    </Ellipse.Stroke>
                                </Ellipse>
                                <Ellipse Width="100" Height="100" Fill="#1D4ED8">
                                </Ellipse>
                                <TextBlock Text="📱" FontSize="44"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock x:Name="ReadyToScanText" Text="READY TO SCAN"
                                       FontSize="40" FontWeight="ExtraBold"
                                       HorizontalAlignment="Center"
                                        Foreground="#0A3D91"
                                       TextOptions.TextFormattingMode="Display">
                            </TextBlock>

                            <TextBlock Text="Tap your RFID card on the reader"
                                       FontSize="17" Foreground="#455A64"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>

                            <!-- Thin divider -->
                            <Border Height="1" Margin="80,28" CornerRadius="0.5" Background="#E0E0E0">
                            </Border>

                            <!-- Manual entry hint -->
                            <Border CornerRadius="14" Padding="28,14"
                                    HorizontalAlignment="Center" Background="#FFF8E1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="⌨" FontSize="15" Foreground="#EF6C00"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock FontSize="14" VerticalAlignment="Center">
                                            <Run Text="Press " Foreground="#EF6C00"/>
                                            <Run Text="SPACEBAR" Foreground="#F57C00" FontWeight="ExtraBold" FontSize="16"/>
                                            <Run Text="  to type your ID manually" Foreground="#EF6C00"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="(If the RFID card reader doesn't detect your card)"
                                               FontSize="10.5" Foreground="#BDBDBD"
                                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- RIGHT — Recent attendance feed -->
                    <Border Grid.Column="2" CornerRadius="28" Padding="22,20" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1.5">
                        <Border.Background>
                            <SolidColorBrush Color="White"/>
                        </Border.Background>
                        

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Section header -->
                            <Border Grid.Row="0" CornerRadius="12" Padding="14,8"
                                    Margin="0,0,0,14" Background="#DBEAFE">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋" FontSize="17"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="RECENT ATTENDANCE" FontSize="15"
                                               FontWeight="Bold" Foreground="#0A3D91"
                                               VerticalAlignment="Center"
                                               TextOptions.TextFormattingMode="Display"/>
                                </StackPanel>
                            </Border>

                            <!-- List (rebuilt: stable scrolling + stretched items) -->
                            <ListView Grid.Row="1" ItemsSource="{Binding RecentAttendance}"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.CanContentScroll="True"
                                      Background="Transparent" BorderThickness="0"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      IsHitTestVisible="False"
                                      HorizontalContentAlignment="Stretch">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Padding="10,10"
                                                    CornerRadius="16"
                                                    BorderBrush="#E3E8F2"
                                                    BorderThickness="1">
                                                <Border.Background>
                                                    <SolidColorBrush Color="#F8FAFD"/>
                                                </Border.Background>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Photo avatar -->
                                                    <Border Grid.Column="0" Width="46" Height="46"
                                                            CornerRadius="23" Margin="0,0,12,0"
                                                            BorderBrush="#3B82F6" BorderThickness="1.5"
                                                            Background="#64748B">
                                                        <Grid>
                                                            <TextBlock Text="&#xE77B;"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="20"
                                                                       Foreground="#E2E8F0"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                            <Border CornerRadius="23" ClipToBounds="True"
                                                                    Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibility}}">
                                                                <Image Source="{Binding Photo}"
                                                                       RenderOptions.BitmapScalingMode="LowQuality"
                                                                       Stretch="UniformToFill"
                                                                       Width="43" Height="43"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Info -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                                Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding FullName}"
                                                                   FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="#14532D"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Department}"
                                                                   FontSize="11.5" Foreground="#455A64"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- Badge -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                                HorizontalAlignment="Right">
                                                        <Border CornerRadius="8" Padding="10,3"
                                                                HorizontalAlignment="Right" Margin="0,0,0,2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#2E7D32"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding LogType}" Value="OUT">
                                                                            <Setter Property="Background" Value="#E65100"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding LogTypeText}"
                                                                       FontSize="10.5" FontWeight="Bold"
                                                                       Foreground="White"/>
                                                        </Border>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding StatusText}"
                                                                       FontSize="11" FontWeight="Bold"
                                                                       Foreground="{Binding StatusBrush}"
                                                                       Margin="0,0,4,0"/>
                                                            <TextBlock Text="{Binding LogTimeFormatted}"
                                                                       FontSize="11" Foreground="#455A64"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding TimeInFormatted}"
                                                                       FontSize="10.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#0D47A1"/>
                                                            <TextBlock Text=" - "
                                                                       FontSize="10.5"
                                                                       Foreground="#607D8B"/>
                                                            <TextBlock Text="{Binding TimeOutFormatted}"
                                                                       FontSize="10.5"
                                                                       FontWeight="SemiBold"
                                                                    Foreground="#166534"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- STATE 3 — Profile (handled by popup) -->
            <Grid Visibility="{Binding IsShowingProfile, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- ════════════════════════════════════════════════════════
             FOOTER — dark bar with centred system info
             ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#DCE7F8">

            <Grid>
                <!-- Centred system info -->
                <TextBlock Text="STI College Santa Rosa  ·  RFID Attendance Management System"
                           Foreground="#334155" FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- REPORTING DAY INFORMATION DIALOG OVERLAY -->
        <Grid x:Name="ReportingDayInfoOverlay" 
              Grid.RowSpan="3"
              Background="#80000000"
              Visibility="Collapsed"
              Panel.ZIndex="1000">
            
            <!-- Main Dialog Container -->
            <Border Background="#2196F3"
                    CornerRadius="20"
                    MaxWidth="900"
                    MaxHeight="600"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="50">
                
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header -->
                    <Border Grid.Row="0"
                            Background="#1976D2"
                            CornerRadius="20,20,0,0"
                            Padding="30,20">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <!-- Information Icon -->
                            <Ellipse Width="60" Height="60"
                                     Fill="White"
                                     Margin="0,0,20,0"/>
                            <TextBlock Text="i"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#1976D2"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="-80,0,20,0"/>
                            
                            <TextBlock Text="INFORMATION"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Content -->
                    <ScrollViewer Grid.Row="1" 
                                  Padding="40,30"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            
                            <!-- Holiday Name -->
                            <TextBlock x:Name="HolidayNameText"
                                       Text="Class Suspension - Reporting Day"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       TextAlignment="Center"
                                       Margin="0,0,0,20"/>
                            
                            <!-- Main Message -->
                            <Border Background="#1565C0"
                                    CornerRadius="15"
                                    Padding="25"
                                    Margin="0,0,0,25">
                                <StackPanel>
                                    <TextBlock Text="&#x1F4E2; TODAY IS REPORTING DAY"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="#FFEB3B"
                                               TextAlignment="Center"
                                               Margin="0,0,0,10"/>
                                    
                                    <TextBlock x:Name="MainMessageText"
                                               Text="Classes are SUSPENDED but reporting staff must be present."
                                               FontSize="16"
                                               Foreground="White"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Staff Type Instructions -->
                            <Border Background="White"
                                    CornerRadius="15"
                                    Padding="25"
                                    Margin="0,0,0,20">
                                <StackPanel>
                                    <!-- Teaching Staff Instructions -->
                                    <Border x:Name="TeachingStaffInstructions"
                                            Background="#E8F5E8"
                                            CornerRadius="10"
                                            Padding="20"
                                            Margin="0,0,0,15"
                                            Visibility="Visible">
                                        <StackPanel>
                                            <TextBlock Text="&#x1F4DA; TEACHING STAFF (REPORTING REQUIRED)"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="#2E7D32"
                                                       Margin="0,0,0,10"/>
                                            
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="&#x2022;" FontSize="14" Margin="0,0,10,0"/>
                                                <TextBlock x:Name="TeachingStatusText"
                                                           Text="Attendance Status: ADMIN TIME"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1976D2"/>
                                            </StackPanel>
                                            
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="&#x2022;" FontSize="14" Margin="0,0,10,0"/>
                                                <TextBlock Text="No late/undertime calculation"
                                                           FontSize="14"
                                                           Foreground="#555"/>
                                            </StackPanel>
                                            
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="&#x2022;" FontSize="14" Margin="0,0,10,0"/>
                                                <TextBlock Text="Report to your designated area"
                                                           FontSize="14"
                                                           Foreground="#555"/>
                                            </StackPanel>
                                            
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#x2022;" FontSize="14" Margin="0,0,10,0"/>
                                                <TextBlock Text="Participate in alternative duties"
                                                           FontSize="14"
                                                           Foreground="#555"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Non-Teaching Staff Instructions -->
                                    <Border x:Name="NonTeachingStaffInstructions"
                                            Background="#FFF3E0"
                                            CornerRadius="10"
                                            Padding="20"
                                            Visibility="Visible">
                                        <StackPanel>
                                            <TextBlock Text="&#x1F454; NON-TEACHING STAFF"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="#E65100"
                                                       Margin="0,0,0,10"/>
                                            
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="&#x2022;" FontSize="14" Margin="0,0,10,0"/>
                                                <TextBlock Text="Attendance Status: Will be calculated normally"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#D84315"/>
                                            </StackPanel>
                                            
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="&#x2022;" FontSize="14" Margin="0,0,10,0"/>
                                                <TextBlock Text="Late/On Time/Undertime based on actual tap time"
                                                           FontSize="14"
                                                           Foreground="#555"/>
                                            </StackPanel>
                                            
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="&#x2022;" FontSize="14" Margin="0,0,10,0"/>
                                                <TextBlock Text="Follow your regular working schedule"
                                                           FontSize="14"
                                                           Foreground="#555"/>
                                            </StackPanel>
                                            
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="&#x2022;" FontSize="14" Margin="0,0,10,0"/>
                                                <TextBlock Text="Report to your designated area"
                                                           FontSize="14"
                                                           Foreground="#555"/>
                                            </StackPanel>
                                            
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#x2022;" FontSize="14" Margin="0,0,10,0"/>
                                                <TextBlock Text="NO ADMIN TIME for Non-Teaching staff"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="#D32F2F"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            
                            <!-- Additional Info -->
                            <Border Background="#BBDEFB"
                                    CornerRadius="10"
                                    Padding="20"
                                    Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="&#x1F4C5; Date Information"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#1565C0"
                                               Margin="0,0,0,10"/>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="&#x2022;" FontSize="14" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="DateInfoText"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1976D2"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x2022;" FontSize="14" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="TimeInfoText"
                                                   FontSize="14"
                                                   Foreground="#555"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- Footer Button -->
                    <Border Grid.Row="2"
                            Padding="30,20">
                        <Border Background="#1976D2"
                                CornerRadius="25"
                                Cursor="Hand"
                                HorizontalAlignment="Center">
                            
                            <Button x:Name="ReportingDayOkButton"
                                    Background="Transparent"
                                    Foreground="White"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Padding="40,15"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Content="&#x2705; OK, I UNDERSTAND"
                                    Click="ReportingDayOkButton_Click">
                                <!-- Button Hover Effect -->
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1565C0"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#0D47A1"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Border>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ?? REPORTING DAY INFORMATION DIALOG (Center Blue Information - Shows First) -->
        <Grid x:Name="ReportingDayWarningOverlay" 
              Grid.RowSpan="3"
              Background="#80000000"
              Visibility="Collapsed"
              Panel.ZIndex="1100">
            
            <!-- Information Dialog Container -->
            <Border Background="#2196F3"
                    CornerRadius="20"
                    MaxWidth="600"
                    MaxHeight="500"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="50">
                
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Information Icon -->
                    <Border Grid.Row="0" Padding="30,40,30,20">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Large Information Icon -->
                            <Viewbox Width="80" Height="80" Margin="0,0,0,20">
                                <Grid>
                                    <Ellipse Width="100" Height="100" Fill="White"/>
                                    <TextBlock Text="i" 
                                             FontSize="48" 
                                             FontWeight="Bold" 
                                             Foreground="#2196F3"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Margin="0,5,0,0"/>
                                </Grid>
                            </Viewbox>
                            
                            <TextBlock Text="&#x2139;&#xFE0F; INFORMATION"
                                       FontSize="36"
                                       FontWeight="Black"
                                       Foreground="White"
                                       TextAlignment="Center">
                                
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    
                    <!-- Information Message -->
                    <Border Grid.Row="1" Padding="40,20">
                        <StackPanel>
                            <!-- Holiday Name -->
                            <TextBlock x:Name="WarningHolidayText"
                                       Text=""
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       TextAlignment="Center"
                                       Margin="0,0,0,20"
                                       TextWrapping="Wrap"/>
                            
                            <!-- Date Info -->
                            <Border Background="#1976D2"
                                    CornerRadius="12"
                                    Padding="20"
                                    Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock x:Name="WarningDateText"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               TextAlignment="Center"
                                               Margin="0,0,0,5"/>
                                    
                                    <TextBlock x:Name="WarningHolidayTypeText"
                                               FontSize="14"
                                               Foreground="#BBDEFB"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!-- OK Button with Countdown -->
                    <Border Grid.Row="2" Padding="40,20">
                        <Button x:Name="WarningOkButton"
                                Content="&#x2705; OK, I UNDERSTAND"
                                Background="#1976D2"
                                Foreground="White"
                                FontSize="18"
                                FontWeight="Bold"
                                Padding="40,15"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="WarningOkButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" 
                                                       Background="{TemplateBinding Background}"
                                                       CornerRadius="25"
                                                       Padding="{TemplateBinding Padding}">
                                                    
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#1565C0"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#0D47A1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ?? CLASS INFORMATION DIALOG -->
        <Grid x:Name="OnlineClassInfoOverlay" 
              Grid.RowSpan="3"
              Background="#80000000"
              Visibility="Collapsed"
              Panel.ZIndex="1100">
            
            <!-- Information Dialog Container -->
            <Border Background="#16A34A"
                    CornerRadius="20"
                    MaxWidth="600"
                    MaxHeight="500"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="50">
                
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Information Icon -->
                    <Border Grid.Row="0" Padding="30,40,30,20">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Large Online Icon -->
                            <Viewbox Width="80" Height="80" Margin="0,0,0,20">
                                <Grid>
                                    <Ellipse Width="100" Height="100" Fill="White"/>
                                    <TextBlock Text="&#x1F4BB;" 
                                             FontSize="40" 
                                             FontWeight="Bold"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Margin="0,5,0,0"/>
                                </Grid>
                            </Viewbox>
                            
                            <TextBlock Text="&#x1F4BB; CLASS ADVISORY"
                                       FontSize="36"
                                       FontWeight="Black"
                                       Foreground="White"
                                       TextAlignment="Center">
                                
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    
                    <!-- Information Message -->
                    <Border Grid.Row="1" Padding="40,20">
                        <StackPanel>
                            <!-- Holiday Name -->
                            <TextBlock x:Name="OnlineClassHolidayText"
                                       Text=""
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       TextAlignment="Center"
                                       Margin="0,0,0,20"
                                       TextWrapping="Wrap"/>
                            
                            <!-- Date Info -->
                            <Border Background="#15803D"
                                    CornerRadius="12"
                                    Padding="20"
                                    Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock x:Name="OnlineClassDateText"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               TextAlignment="Center"
                                               Margin="0,0,0,5"/>
                                    
                                    <TextBlock x:Name="OnlineClassHolidayTypeText"
                                               FontSize="14"
                                               Foreground="#DCFCE7"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!-- OK Button with Countdown -->
                    <Border Grid.Row="2" Padding="40,20">
                        <Button x:Name="OnlineClassOkButton"
                                Content="&#x2705; OK, I UNDERSTAND"
                                Background="#15803D"
                                Foreground="White"
                                FontSize="18"
                                FontWeight="Bold"
                                Padding="40,15"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="OnlineClassOkButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" 
                                                       Background="{TemplateBinding Background}"
                                                       CornerRadius="25"
                                                       Padding="{TemplateBinding Padding}">
                                                    
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#166534"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#14532D"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>


